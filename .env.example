# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/driving_school?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Sign-In: OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application).
# Must match the NEXT_PUBLIC_GOOGLE_CLIENT_ID used by the frontend — it's the same value on both sides.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# One-time bootstrap admin (used only by the seed script to create/upgrade an admin account)
ADMIN_EMAIL=admin@drivingschool.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Subscriptions (Rhema Driving School monthly access) ----
# Flat monthly price in Ghana Cedis — the single place to change the price. The frontend fetches
# this live from GET /api/payments/config, so changing it here takes effect immediately.
SUBSCRIPTION_PRICE_GHS=70
SUBSCRIPTION_PERIOD_DAYS=30

# Paystack (https://dashboard.paystack.com -> Settings -> API Keys & Webhooks)
# SECRET key stays server-side only. PUBLIC key also goes in frontend/.env.local as
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY. Use the sk_test_/pk_test_ keys while developing.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
